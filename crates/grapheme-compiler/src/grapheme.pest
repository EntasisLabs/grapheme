// ─────────────────────────────────────────────────────────────
//  Grapheme Grammar  (pest.rs PEG)
//  A GraphQL-style DSL for AI agents, compiled to WASM via Wasmer
// ─────────────────────────────────────────────────────────────

// ── Whitespace & Comments ────────────────────────────────────

WHITESPACE = _{ " " | "\t" | "\r" | "\n" }

COMMENT = _{ "//" ~ (!"\n" ~ ANY)* ~ "\n"? }

// ── Primitives ───────────────────────────────────────────────

ident = @{ (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")* }

string_lit = @{ "\"" ~ (("\\" ~ ANY) | (!("\"" | "\\") ~ ANY))* ~ "\"" }

int_lit = @{ "-"? ~ ASCII_DIGIT+ }

float_lit = @{ "-"? ~ ASCII_DIGIT+ ~ "." ~ ASCII_DIGIT+ }

bool_lit = { "true" | "false" }

null_lit = { "null" }

variable = ${ "$" ~ ident ~ ("." ~ ident)* }

symbol_lit = { ident }

qualified_ident = @{ ident ~ ("::" ~ ident)? }

compare_op = { "==" | ">=" | "<=" | ">" | "<" }

// ── Values ───────────────────────────────────────────────────

value = {
    string_lit
  | float_lit
  | int_lit
  | bool_lit
  | null_lit
  | variable
    | symbol_lit
  | list_value
  | object_value
}

list_value = { "[" ~ (value ~ ("," ~ value)*)? ~ "]" }

object_value = { "{" ~ (object_field ~ ("," ~ object_field)*)? ~ "}" }

object_field = { ident ~ ":" ~ value }

// ── Arguments ────────────────────────────────────────────────

named_arg  = { ident ~ ":" ~ value }

arg_list   = { "(" ~ (named_arg ~ ("," ~ named_arg)*)? ~ ")" }

type_named_arg = { ident ~ ":" ~ type_ref }

type_arg_list = { "(" ~ (type_named_arg ~ ("," ~ type_named_arg)*)? ~ ")" }

// ── Directives  (@ annotations on any node) ──────────────────

directive = { "@" ~ ident ~ (arg_list | object_value)? }

// ── Type System ───────────────────────────────────────────────

scalar_type = { "String" | "Int" | "Float" | "Bool" | "Any" | "Json" }

list_type = { "[" ~ type_ref ~ "]" }

type_ref = { (scalar_type | list_type | qualified_ident) ~ "!"? }

field_def = { ident ~ ":" ~ type_ref ~ directive* }

struct_field_def = { ident ~ "?"? ~ ":" ~ type_ref }

struct_def = {
    "struct" ~ ident ~ "{"
    ~ struct_field_def+
    ~ "}"
}

enum_def = {
    "enum" ~ ident ~ "{" ~ ident ~ ("," ~ ident)* ~ "}"
}

state_terminal_def = { "terminal" ~ ident }

state_transition_def = { "transition" ~ ident ~ "->" ~ ident }

state_machine_def = {
    "state_machine" ~ ident ~ "on" ~ ident ~ "{"
    ~ (state_terminal_def | state_transition_def)+
    ~ "}"
}

type_def = {
    "type" ~ ident ~ directive* ~ "{"
    ~ field_def+
    ~ "}"
}

schema_def = {
    "schema" ~ "{"
    ~ type_def+
    ~ "}"
}

// ── Module System ────────────────────────────────────────────

op_kind = { "query" | "mutation" }

op_def = {
    op_kind ~ ident ~ type_arg_list? ~ ":" ~ type_ref
}

// AI-proposed module: submitted to runtime for approval / registration
module_proposal = {
    "propose" ~ "module" ~ ident ~ "{"
    ~ op_def+
    ~ "}"
}

// A registered (built-in or approved) module import
import_kind = { "types" }

import_decl = {
    "import" ~ import_kind? ~ ident ~ "from" ~ string_lit
}

// ── Selection Sets ────────────────────────────────────────────

// What fields the caller wants back — mirrors GraphQL selection sets
selection_set = {
    "{" ~ selected_field+ ~ "}"
}

selected_field = {
    spread_field
  | state_field
  | aliased_field
  | plain_field
}

// ...FragmentName  — spread a named fragment into the selection
spread_field = { "..." ~ ident }

// state { } — special keyword to inspect AgentState at this point
state_field = {
    "state" ~ "{"
    ~ state_selector+
    ~ "}"
}

state_selector = {
    "current" | "diff" | "errors" | "pipeline" | "proposed"
}

// alias: FieldCall(...)
aliased_field = { ident ~ ":" ~ field_call }

plain_field = { field_call | ident }

// ── Field Calls & Pipelines ───────────────────────────────────

module_prefix = { ident ~ "." }

// A single pipeline step: [Module.]op(args) { selection }
field_call = {
    module_prefix?
    ~ ident
    ~ arg_list?
    ~ directive*
    ~ selection_set?
}

// A fragment/call-target invocation step: call StepName(args) { selection }
call_step = {
    "call"
    ~ ident
    ~ arg_list?
    ~ directive*
    ~ selection_set?
}

// Struct initializer step: TypeName { field: value, ... }
struct_init_step = {
    qualified_ident
    ~ object_value
}

if_step = {
    "if"
    ~ variable
    ~ compare_op
    ~ value
    ~ "then"
    ~ branch_target
    ~ "else"
    ~ branch_target
}

match_step = {
    "match"
    ~ variable
    ~ "{" 
    ~ match_case+
    ~ match_default
    ~ "}"
}

match_case = {
    "case"
    ~ value
    ~ ("," ~ value)*
    ~ "=>"
    ~ match_target
}

match_default = {
    "default"
    ~ "=>"
    ~ match_target
}

inline_target_step = {
    transition_step
    | apply_step
    | set_step
    | struct_init_step
    | call_step
    | field_call
}

inline_target_pipe = { "|>" ~ inline_target_step }

inline_target_pipeline = {
    inline_target_step
    ~ inline_target_pipe*
}

branch_target = {
    inline_target_pipeline
    | symbol_lit
}

match_target = {
    match_step
    | branch_target
}

set_step = {
    "set"
    ~ object_value
}

apply_step = {
    "apply"
    ~ ident
    ~ object_value
}

transition_step = {
    "transition"
    ~ variable
    ~ "->"
    ~ value
    ~ object_value?
}

using_mutability = { "const" | "mutable" }

using_binding = {
    using_mutability? ~ ("$" ~ ident ~ ":")? ~ ident ~ (arg_list | object_value)
}

// Scoped ambient activation (RFC-0004): using auth(...) { ... }
using_step = {
    "using"
    ~ using_binding
    ~ ("," ~ using_binding)*
    ~ "{"
    ~ pipeline+
    ~ "}"
}

// The pipe operator |> chains steps left to right
// Each step receives the AgentState from the previous
pipe_step = { "|>" ~ (match_step | if_step | transition_step | apply_step | set_step | struct_init_step | using_step | call_step | field_call) }

pipeline = {
    (match_step | if_step | transition_step | apply_step | set_step | struct_init_step | using_step | call_step | field_call) ~ pipe_step*
}

// ── Top-Level Definitions ─────────────────────────────────────

// Variables block at the top of a query/mutation
variable_def = { "$" ~ ident ~ ":" ~ type_ref ~ ("=" ~ value)? }

variable_defs = { "(" ~ (variable_def ~ ("," ~ variable_def)*)? ~ ")" }

executable_signature = { "on" ~ type_ref ~ ("->" ~ type_ref)? }

glyph_def = {
    "glyph" ~ ident ~ "{"
    ~ pipeline+
    ~ "}"
}

query_def = {
    "query" ~ ident ~ variable_defs? ~ executable_signature? ~ directive* ~ "{"
    ~ pipeline+
    ~ "}"
}

mutation_def = {
    "mutation" ~ ident ~ variable_defs? ~ executable_signature? ~ directive* ~ "{"
    ~ pipeline+
    ~ "}"
}

// Iterators: reusable named executable pipelines (like functions)
iterator_def = {
    "iterator" ~ ident ~ variable_defs? ~ executable_signature ~ directive* ~ "{"
    ~ pipeline+
    ~ "}"
}

// Node alias: semantic equivalent of iterator
node_def = {
    "node" ~ ident ~ variable_defs? ~ executable_signature ~ directive* ~ "{"
    ~ pipeline+
    ~ "}"
}

// Fragments: reusable inline pipelines (non-executable in Phase A)
fragment_def = {
    "fragment" ~ ident ~ executable_signature ~ directive* ~ "{"
    ~ pipeline+
    ~ "}"
}

// Subscription: event-driven / reactive loop
subscription_def = {
    "subscription" ~ ident ~ variable_defs? ~ executable_signature? ~ directive* ~ "{"
    ~ pipeline+
    ~ "}"
}

// Tag schema (RFC-0004): ambient context type
tag_def = {
    "tag" ~ ident ~ ("for" ~ "[" ~ ident ~ ("," ~ ident)* ~ "]")? ~ "{"
    ~ variable_def+
    ~ "}"
}

// Program-scoped named handle: using const $session: auth(...)
using_decl = {
    "using" ~ using_mutability ~ "$" ~ ident ~ ":" ~ ident ~ (arg_list | object_value)
}

// ── Program Root ──────────────────────────────────────────────

definition = {
        glyph_def
    |
    query_def
  | mutation_def
    | iterator_def
        | node_def
    | fragment_def
  | subscription_def
    | struct_def
    | enum_def
    | state_machine_def
    | tag_def
    | using_decl
  | schema_def
  | module_proposal
}

program = {
    SOI
    ~ import_decl*
    ~ definition+
    ~ EOI
}
