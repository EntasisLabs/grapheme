{
  "name": "Grapheme Lang",
  "scopeName": "source.grapheme",
  "patterns": [
    { "include": "#comments" },
    { "include": "#imports" },
    { "include": "#declarations" },
    { "include": "#directives" },
    { "include": "#moduleCalls" },
    { "include": "#variables" },
    { "include": "#keywords" },
    { "include": "#control" },
    { "include": "#types" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.gr",
          "begin": "//",
          "end": "$"
        }
      ]
    },
    "imports": {
      "patterns": [
        {
          "name": "meta.import.gr",
          "match": "\\bimport\\s+(types\\s+)?([A-Za-z_][A-Za-z0-9_]*)\\s+from\\s+(\"[^\"]+\")",
          "captures": {
            "0": { "name": "meta.import.gr" },
            "1": { "name": "storage.modifier.gr" },
            "2": { "name": "entity.name.namespace.gr" },
            "3": { "name": "string.quoted.double.gr" }
          }
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "name": "meta.definition.executable.gr",
          "match": "\\b(glyph|query|mutation|iterator|subscription)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.executable.gr" },
            "2": { "name": "entity.name.function.gr" }
          }
        },
        {
          "name": "meta.definition.struct.gr",
          "match": "\\bstruct\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "0": { "name": "meta.definition.struct.gr" },
            "1": { "name": "entity.name.type.gr" }
          }
        }
      ]
    },
    "directives": {
      "patterns": [
        {
          "name": "meta.annotation.gr",
          "match": "@[A-Za-z_][A-Za-z0-9_]*",
          "captures": {
            "0": { "name": "entity.name.tag.gr" }
          }
        }
      ]
    },
    "moduleCalls": {
      "patterns": [
        {
          "name": "meta.function.module-call.gr",
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\.([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.namespace.gr" },
            "2": { "name": "support.function.gr" }
          }
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.language.gr",
          "match": "\\$[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.gr",
          "match": "\\b(import|from|glyph|query|mutation|iterator|subscription|fragment|on|schema|type|types|struct|propose|module)\\b"
        },
        {
          "name": "constant.language.gr",
          "match": "\\b(true|false|null)\\b"
        }
      ]
    },
    "control": {
      "patterns": [
        {
          "name": "keyword.control.flow.gr",
          "match": "\\b(return|then|else|when)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.builtin.gr",
          "match": "\\b(String|Float|Int|Bool|Object|Any|Json|JsonValue)\\b"
        },
        {
          "name": "entity.name.type.namespaced.gr",
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)::([A-Za-z_][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": { "name": "entity.name.namespace.gr" },
            "2": { "name": "entity.name.type.gr" }
          }
        },
        {
          "name": "entity.name.type.signature.gr",
          "match": "\\bon\\s+([A-Za-z_][A-Za-z0-9_]*(?:::[A-Za-z_][A-Za-z0-9_]*)?)\\s*(?:->\\s*([A-Za-z_][A-Za-z0-9_]*(?:::[A-Za-z_][A-Za-z0-9_]*)?))?",
          "captures": {
            "1": { "name": "entity.name.type.gr" },
            "2": { "name": "entity.name.type.gr" }
          }
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.gr",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "meta.interpolation.gr",
              "match": "\\{\\$[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*\\}"
            },
            {
              "name": "constant.character.escape.gr",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.gr",
          "match": "\\b-?\\d+(?:\\.\\d+)?\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.pipeline.gr",
          "match": "\\|>"
        },
        {
          "name": "keyword.operator.assignment.gr",
          "match": ":"
        },
        {
          "name": "keyword.operator.arrow.gr",
          "match": "->"
        }
      ]
    }
  }
}
