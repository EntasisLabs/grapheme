{
  "name": "grapheme-vscode",
  "displayName": "Grapheme Lang",
  "description": "Grapheme Lang (.gr) support powered by a prebuilt LSP binary",
  "version": "0.6.0",
  "publisher": "grapheme-dev",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/entasislabs/grapheme.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "files": [
    "out/**",
    "syntaxes/**",
    "language-configuration.json",
    "README.md",
    "LICENSE",
    "package.json",
    "node_modules/**"
  ],
  "categories": [
    "Programming Languages",
    "Linters",
    "Formatters"
  ],
  "activationEvents": [
    "onLanguage:grapheme"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "grapheme",
        "aliases": [
          "Grapheme Lang",
          "grapheme",
          "gr"
        ],
        "extensions": [
          ".gr"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "grapheme",
        "scopeName": "source.grapheme",
        "path": "./syntaxes/gr.tmGrammar.json"
      }
    ],
    "configuration": {
      "title": "Grapheme",
      "properties": {
        "grapheme.lsp.binaryPath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to a prebuilt grapheme-lsp binary. If set, download is skipped."
        },
        "grapheme.lsp.releaseRepo": {
          "type": "string",
          "default": "entasislabs/grapheme",
          "description": "GitHub owner/repo hosting grapheme-lsp release assets."
        },
        "grapheme.lsp.releaseTag": {
          "type": "string",
          "default": "latest",
          "description": "Release tag to fetch. Use latest or a concrete tag like v0.5.0."
        },
        "grapheme.lsp.autoDownload": {
          "type": "boolean",
          "default": true,
          "description": "Automatically download grapheme-lsp binary when missing."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p .",
    "watch": "tsc -w -p ."
  },
  "devDependencies": {
    "@types/node": "^20.16.10",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
