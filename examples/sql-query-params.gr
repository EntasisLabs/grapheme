import sql from "grapheme/sql"

query SqlQueryParams {
  set {
    connection: "sqlite::memory:",
    statement: "select ?1 as id, ?2 as label, ?3 as enabled, ?4 as ratio, ?5 as empty",
    params: [7, "alpha", true, 3.14, null]
  }
  |> sql.query(
    connection: $current.connection,
    sql: $current.statement,
    params: $current.params
  )
}
