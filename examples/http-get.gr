glyph HttpGetGoogleMarkdown {
  set { url: "https://medium.com/@apsingiakshay46/stategraph-to-build-build-complex-workflows-involving-llms-8f77e7e03236" }
  |> http.get(url: $state.url)
  |> core.pick(fields: ["body"], input: $state)
  |> html.to_md(html: $state.body)
  |> core.echo(message: $state.text)
}
