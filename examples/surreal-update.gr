import surreal from "grapheme/surreal"

query SurrealUpdate {
  set {
    connection: "local",
    target: "person:demo",
    data: {
      active: false,
      tier: "platinum"
    }
  }
  |> surreal.update(
    connection: $current.connection,
    thing_or_table: $current.target,
    data: $current.data
  )
}
