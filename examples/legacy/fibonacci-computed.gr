query FibonacciComputed {
  core.merge(left: {}, right: { a: 0.0, b: 1.0, i: 0.0, max: 10.0 })
  |> FibIter
}

iterator FibIter on Any @loop(max: 10, merge: "replace") {
  core.echo(message: "fib:$state.a")
  |> core.add(a: $state.a, b: $state.b)
  |> core.merge(left: $state, right: { a: $state.b, b: $state.value })
  |> core.inc_field(field: "i")
}
