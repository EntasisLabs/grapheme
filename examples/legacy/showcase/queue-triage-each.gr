query QueueTriageEach {
  core.merge(
    left: {},
    right: {
      tasks: [
        { id: "t-100", priority: "high" },
        { id: "t-101", priority: "low" },
        { id: "t-102", priority: "high" }
      ]
    }
  )
  |> Triage
}

iterator Triage on Any @loop(each: "$state.tasks", merge: "append") {
  match $item.priority {
    case high, critical => EscalateTask
    default => StandardTask
  }
}

iterator EscalateTask on Any {
  core.merge(left: $item, right: { queue: "expedite" })
  |> core.echo(message: "expedite:$item.id")
  |> core.pick(fields: ["id", "priority", "queue", "message"])
}

iterator StandardTask on Any {
  core.merge(left: $item, right: { queue: "standard" })
  |> core.echo(message: "standard:$item.id")
  |> core.pick(fields: ["id", "priority", "queue", "message"])
}
