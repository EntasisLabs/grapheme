import types Domain from "./types-domain.gr"

query FibonacciThresholdNamespaced on Domain::FibState -> Domain::FibState {
  Domain::FibState { a: 0.0, b: 1.0, i: 0.0, threshold: 144.0 }
  |> FibUntilThreshold
}

iterator FibUntilThreshold on Domain::FibState -> Domain::FibState @loop(max: 64, merge: "replace") {
  core.echo(message: "fib:{$state.a}")
  |> flow.branch(
    when: { field: "a", gte: $state.threshold },
    then: return,
    else: AdvanceFib
  )
}

iterator AdvanceFib on Domain::FibState -> Domain::FibState {
  core.set_fields(fields: { prev_a: $state.a, prev_b: $state.b })
  |> core.add(a: $state.prev_a, b: $state.prev_b)
  |> core.set_fields(fields: { a: $state.prev_b, b: $state.value })
  |> core.inc_field(field: "i")
}
