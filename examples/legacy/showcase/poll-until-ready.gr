query PollUntilReady {
  core.merge(left: {}, right: { status: "pending", attempt: 0.0, ready_at: 3.0 })
  |> Poller
}

iterator Poller on Any @core_default @loop(max: 8, until: { field: "status", eq: "ready" }, merge: "replace") {
  inc_field(field: "attempt")
  |> flow.branch(
    when: { field: "attempt", eq: 3.0 },
    then: MarkReady,
    else: KeepWaiting
  )
}

iterator MarkReady on Any @core_default {
  core.merge(left: $state, right: { status: "ready" })
  |> echo(message: "ready-at:$state.attempt")
}

iterator KeepWaiting on Any @core_default {
  echo(message: "waiting:$state.attempt")
}
