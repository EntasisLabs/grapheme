// Example Grapheme program
// An AI agent fetching users and streaming results over a websocket

import Database from "grapheme/db"
import WebSocket from "grapheme/ws"

schema {
  type User {
    id: String!
    name: String!
    email: String!
    role: String
  }
}

query FetchActiveUsers($minAge: Int = 18) {
  Database.query(
    sql: "SELECT * FROM users WHERE active = true AND age >= $minAge",
    params: { minAge: $minAge }
  ) {
    rows {
      id
      name
      email
    }
    state { current errors }
  }
  |> validate(schema: "User")
  |> transform(mapping: "UserToDTO")
}

mutation BroadcastUsers($channel: String!) {
  Database.query(sql: "SELECT id, name FROM users WHERE active = true") {
    rows { id name }
  }
  |> WebSocket.send(channel: $channel) {
    state { current diff errors }
  }
}

fragment UserSummary on User {
  pick(fields: ["id", "name", "role"]) {
    id
    name
    role
  }
}

propose module Analytics {
  query trackEvent(name: String!, payload: Json): Bool
  mutation flushEvents: Int
}
