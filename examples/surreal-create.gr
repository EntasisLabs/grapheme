import surreal from "grapheme/surreal"

query SurrealCreate {
  set {
    connection: "local",
    target: "person:demo",
    data: {
      name: "Ada",
      active: true,
      tier: "gold"
    }
  }
  |> surreal.create(
    connection: $state.connection,
    thing_or_table: $state.target,
    data: $state.data
  )
}
