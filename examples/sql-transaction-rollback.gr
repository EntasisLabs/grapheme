import sql from "grapheme/sql"

query SqlTransactionRollbackDemo {
  set {
    connection: "sqlite::memory:",
    steps: [
      {
        mode: "execute",
        sql: "create table if not exists todos (id integer, title text)"
      },
      {
        mode: "execute",
        sql: "insert into todos (id, title) values (?1, ?2)",
        params: [1, "this should roll back"]
      },
      {
        mode: "execute",
        sql: "this is invalid sql and forces rollback"
      }
    ]
  }
  |> sql.transaction(connection: $current.connection, steps: $current.steps)
}
