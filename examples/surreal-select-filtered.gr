import surreal from "grapheme/surreal"

query SurrealSelectFiltered {
  set {
    connection: "local",
    target: "person",
    where: "active = true",
    limit: 10
  }
  |> surreal.select(
    connection: $state.connection,
    thing_or_table: $state.target,
    where: $state.where,
    limit: $state.limit
  )
}
