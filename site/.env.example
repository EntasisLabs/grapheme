# Origin (scheme + host only, no path) used for canonical / Open Graph URLs.
# GitHub Pages: https://entasislabs.github.io   Custom domain: https://your-domain.example
PUBLIC_SITE_URL=https://your-domain.example

# URL prefix the built site is served under. Leave empty for a root deploy
# (custom domain, local dev). The GitHub Pages project site uses /grapheme;
# CI sets this automatically from actions/configure-pages.
BASE_PATH=
