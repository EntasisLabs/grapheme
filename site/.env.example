# Origin (scheme + host only, no path) used for canonical / Open Graph URLs.
# Production: https://grapheme-lang.org   Bare project site: https://entasislabs.github.io
PUBLIC_SITE_URL=https://grapheme-lang.org

# URL prefix the built site is served under. Leave empty for a root deploy
# (custom domain grapheme-lang.org, local dev). The bare GitHub Pages project
# site uses /grapheme; CI sets this automatically from actions/configure-pages.
BASE_PATH=
