{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grapheme.dev/schemas/module/v1/wasm-module-manifest.schema.json",
  "title": "Grapheme Wasm Module Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "module_id",
    "version",
    "abi",
    "wasm",
    "exported_ops",
    "required_capabilities"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "grapheme.module.manifest/v1"
    },
    "module_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "abi": {
      "type": "string",
      "enum": ["wasix_v1"]
    },
    "wasm": {
      "type": "string",
      "minLength": 1
    },
    "entrypoint": {
      "type": "string",
      "minLength": 1
    },
    "exported_ops": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["op", "effect"],
        "properties": {
          "op": {
            "type": "string",
            "minLength": 1
          },
          "effect": {
            "type": "string",
            "enum": ["pure", "network", "io", "state", "secrets", "control"]
          },
          "input_schema_ref": {
            "type": "string"
          },
          "output_schema_ref": {
            "type": "string"
          }
        }
      }
    },
    "required_capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_cpu_ms": { "type": "integer", "minimum": 1 },
        "max_memory_mb": { "type": "integer", "minimum": 1 },
        "max_io_bytes": { "type": "integer", "minimum": 1 },
        "max_network_calls": { "type": "integer", "minimum": 0 }
      }
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
